# Turkistan International Airport — environment reference
#
# Copy to `.env.local` for development, or set these in the process
# environment in production.
#
# Everything marked OPTIONAL must be genuinely optional: `next build` and
# `next start` are required to succeed with every optional variable unset
# (plan §13). Only the REQUIRED ones are checked, and only at runtime.

# ---------------------------------------------------------------------------
# REQUIRED in production
# ---------------------------------------------------------------------------

# The sole admin credential. There are no user accounts anywhere in this
# system — no signup, no user records, no created admin account (spec §8, §14).
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Canonical origin, used for sitemap, hreflang and absolute URLs.
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Where the SQLite database and uploaded files live. Defaults to ./data
#
# Use an ABSOLUTE path in production. With output: 'standalone', Next's
# server changes directory into .next/standalone before the app loads, so a
# relative path is resolved back to the project root explicitly (see
# lib/env.ts). An absolute path removes the ambiguity, and keeps the
# airport's database and uploaded schedules well away from the build output,
# which is deleted on every deploy.
# DATA_DIR=/var/lib/hsairport

# IANA timezone used to decide what "today" means on the flight board.
# Never derive this from the server clock (plan §4).
# AIRPORT_TZ=Asia/Almaty

# Destination/origin weather on the board (spec §11.2). Uses Open-Meteo, which
# needs no API key. Weather degrades silently — the board never waits on it.
# WEATHER_ENABLED=true

# Email delivery for the feedback form is entirely optional. With SMTP unset,
# submissions are stored in the database and read in the admin inbox, which
# works with zero airport-provided configuration (spec §9).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_TO=
